# --- Amazon Bedrock / S3 Vectors ---
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-v4:0
BEDROCK_EMBEDDING_DIMENSION=1024
BEDROCK_GENERATION_MODEL_ID=us.openai.gpt-5.6-luna
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
S3_VECTOR_BUCKET=jev-rag-comparison
S3_VECTOR_INDEX=soumu-whitepaper-r08

# --- Jev / TypeSafe System One ---
# transport: "gateway" (Vercel AI Gateway, usable before your TypeSafe account opens)
#            "direct"  (api.typesafe.ai, usable once the waiting list clears)
#            "fake"    (offline fixtures, no network, no credentials)
JEV_TRANSPORT=gateway

# gateway transport
AI_GATEWAY_API_KEY=
JEV_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/typesafe/v1
JEV_GATEWAY_MODEL=typesafe-ai/jev

# direct transport
TYPESAFE_API_KEY=
JEV_DIRECT_BASE_URL=https://api.typesafe.ai/v1
JEV_DIRECT_MODEL=jev-latest
