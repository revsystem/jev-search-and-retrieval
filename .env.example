# cp .env.example .env して使う。jev-rag は起動時にこのファイルを読む。
# 既に export されている環境変数のほうが優先される。
#
# 秘密情報は Jev の API キーだけ（使う経路の分）。他は接続先とモデルIDの指定。
# .env は .gitignore に入っているのでコミットされない。

# --- Jev / TypeSafe System One ---
# transport: "direct"  (api.typesafe.ai。測定はこちらで行った)
#            "gateway" (Vercel AI Gateway 経由)
#            "fake"    (オフライン。テストと配線確認用。鍵は不要)
JEV_TRANSPORT=direct

# gateway 経路の秘密情報。Vercel のダッシュボード > AI Gateway > API Keys で発行する。
AI_GATEWAY_API_KEY=
JEV_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/typesafe/v1
JEV_GATEWAY_MODEL=typesafe-ai/jev

# direct 経路の秘密情報。TypeSafe のダッシュボードで発行する。
TYPESAFE_API_KEY=
JEV_DIRECT_BASE_URL=https://api.typesafe.ai/v1
JEV_DIRECT_MODEL=jev-latest

# --- Amazon Bedrock（従来手法の比較対象） ---
# 認証情報はここには書かない。boto3 の既定のチェーンが AWS_PROFILE を見るので、
# プロファイル名だけ指定して `aws sso login --profile <name>` で認証する。
AWS_PROFILE=<プロファイル名>
AWS_REGION=us-east-1

BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-v4:0
BEDROCK_EMBEDDING_DIMENSION=1024
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
BEDROCK_GENERATION_MODEL_ID=us.openai.gpt-5.6-luna
